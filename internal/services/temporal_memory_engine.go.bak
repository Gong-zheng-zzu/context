// deduplicateMemories 去重
func (tme *TemporalMemoryEngine) deduplicateMemories(memories []*TemporalMemory) []*TemporalMemory {
	seen := make(map[string]bool)
	result := make([]*TemporalMemory, 0)

	for _, m := range memories {
		if !seen[m.ID] {
			seen[m.ID] = true
			result = append(result, m)
		}
	}

	return result
}

// MemoryDecayModel 记忆衰减模型
type MemoryDecayModel struct {
	// Ebbinghaus遗忘曲线参数
	DecayRate float64 // 衰减速率
	MinScore  float64 // 最小分数
}

// NewMemoryDecayModel 创建记忆衰减模型
func NewMemoryDecayModel() *MemoryDecayModel {
	return &MemoryDecayModel{
		DecayRate: 0.5,  // 半衰期
		MinScore:  0.1,  // 最小保留10%权重
	}
}

// CalculateDecay 计算记忆衰减分数
// 基于Ebbinghaus遗忘曲线: R = e^(-t/S)
// R: 记忆保持率, t: 时间间隔, S: 记忆强度
func (mdm *MemoryDecayModel) CalculateDecay(memoryTime time.Time, referenceTime time.Time) float64 {
	// 计算时间间隔（小时）
	hoursSince := referenceTime.Sub(memoryTime).Hours()

	// 应用遗忘曲线
	// 使用指数衰减: score = e^(-λt)
	// λ = ln(2) / 半衰期（小时）
	halfLifeHours := 168.0 // 7天半衰期
	lambda := math.Log(2) / halfLifeHours

	decayScore := math.Exp(-lambda * hoursSince)

	// 确保不低于最小分数
	if decayScore < mdm.MinScore {
		decayScore = mdm.MinScore
	}

	return decayScore
}

// AdaptiveWeightAdjuster 自适应权重调整器
type AdaptiveWeightAdjuster struct {
	// 预定义的权重策略
	strategies map[string]*DimensionWeights
}

// DimensionWeights 维度权重
type DimensionWeights struct {
	Vector    float64 `json:"vector"`
	Timeline  float64 `json:"timeline"`
	Knowledge float64 `json:"knowledge"`
}

// NewAdaptiveWeightAdjuster 创建自适应权重调整器
func NewAdaptiveWeightAdjuster() *AdaptiveWeightAdjuster {
	return &AdaptiveWeightAdjuster{
		strategies: map[string]*DimensionWeights{
			// 回忆类查询：侧重时间线
			"recall": {
				Vector:    0.2,
				Timeline:  0.6,
				Knowledge: 0.2,
			},
			// 知识类查询：侧重知识图谱
			"knowledge": {
				Vector:    0.3,
				Timeline:  0.1,
				Knowledge: 0.6,
			},
			// 趋势类查询：平衡时间线和向量
			"trend": {
				Vector:    0.3,
				Timeline:  0.5,
				Knowledge: 0.2,
			},
			// 因果类查询：平衡所有维度
			"causal": {
				Vector:    0.35,
				Timeline:  0.35,
				Knowledge: 0.3,
			},
			// 默认：均衡权重
			"default": {
				Vector:    0.4,
				Timeline:  0.3,
				Knowledge: 0.3,
			},
		},
	}
}

// CalculateWeights 计算自适应权重
func (awa *AdaptiveWeightAdjuster) CalculateWeights(queryIntent string, timeContext *TimeContext) *DimensionWeights {
	// 获取基础权重
	baseWeights, exists := awa.strategies[queryIntent]
	if !exists {
		baseWeights = awa.strategies["default"]
	}

	// 根据时间上下文调整权重
	adjustedWeights := &DimensionWeights{
		Vector:    baseWeights.Vector,
		Timeline:  baseWeights.Timeline,
		Knowledge: baseWeights.Knowledge,
	}

	// 如果指定了时间范围，增加时间线权重
	if timeContext != nil && timeContext.TimeRange != nil {
		adjustedWeights.Timeline += 0.1
		adjustedWeights.Vector -= 0.05
		adjustedWeights.Knowledge -= 0.05
	}

	// 如果是近期查询，增加时间线权重
	if timeContext != nil && timeContext.FocusPeriod == "recent" {
		adjustedWeights.Timeline += 0.15
		adjustedWeights.Vector -= 0.1
		adjustedWeights.Knowledge -= 0.05
	}

	// 归一化（确保总和为1）
	total := adjustedWeights.Vector + adjustedWeights.Timeline + adjustedWeights.Knowledge
	adjustedWeights.Vector /= total
	adjustedWeights.Timeline /= total
	adjustedWeights.Knowledge /= total

	return adjustedWeights
}

// TemporalPatternAnalyzer 时序模式分析器
type TemporalPatternAnalyzer struct{}

// NewTemporalPatternAnalyzer 创建时序模式分析器
func NewTemporalPatternAnalyzer() *TemporalPatternAnalyzer {
	return &TemporalPatternAnalyzer{}
}

// AnalyzePatterns 分析时序模式
func (tpa *TemporalPatternAnalyzer) AnalyzePatterns(memories []*TemporalMemory) []*TemporalPattern {
	patterns := make([]*TemporalPattern, 0)

	// 1. 检测周期性模式
	periodicPatterns := tpa.detectPeriodicPatterns(memories)
	patterns = append(patterns, periodicPatterns...)

	// 2. 检测趋势模式
	trendPatterns := tpa.detectTrendPatterns(memories)
	patterns = append(patterns, trendPatterns...)

	// 3. 检测突发模式
	burstPatterns := tpa.detectBurstPatterns(memories)
	patterns = append(patterns, burstPatterns...)

	return patterns
}

// detectPeriodicPatterns 检测周期性模式
