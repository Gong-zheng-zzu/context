// 接口定义
type VectorRetriever interface {
	Search(ctx context.Context, query string, limit int) ([]*TemporalMemory, error)
}

type TimelineRetriever interface {
	Search(ctx context.Context, query string, timeRange *TimeRange, limit int) ([]*TemporalMemory, error)
}

type KnowledgeRetriever interface {
	Search(ctx context.Context, query string, limit int) ([]*TemporalMemory, error)
}
