// TemporalMemoryEngine 时序记忆引擎
// 核心创新：多维时序感知记忆系统
type TemporalMemoryEngine struct {
	// 基础检索器
	vectorRetriever   VectorRetriever
	timelineRetriever TimelineRetriever
	knowledgeRetriever KnowledgeRetriever

	// 时序分析器
	patternAnalyzer *TemporalPatternAnalyzer
	decayModel      *MemoryDecayModel

	// 自适应权重调整器
	weightAdjuster *AdaptiveWeightAdjuster
}

// TemporalMemoryRequest 时序记忆检索请求
type TemporalMemoryRequest struct {
	UserID      string    `json:"user_id"`
	WorkspaceID string    `json:"workspace_id"`
	Query       string    `json:"query"`
	QueryIntent string    `json:"query_intent"` // recall/knowledge/trend/causal
	TimeContext *TimeContext `json:"time_context,omitempty"`
	Limit       int       `json:"limit"`
}

// TimeContext 时间上下文
type TimeContext struct {
	ReferenceTime time.Time  `json:"reference_time"` // 参考时间点（默认为当前时间）
	TimeRange     *TimeRange `json:"time_range,omitempty"`
	FocusPeriod   string     `json:"focus_period"` // recent/week/month/year/all
}

// TimeRange 时间范围
type TimeRange struct {
	StartTime time.Time `json:"start_time"`
	EndTime   time.Time `json:"end_time"`
}

// TemporalMemoryResult 时序记忆检索结果
type TemporalMemoryResult struct {
	Memories         []*TemporalMemory      `json:"memories"`
	TemporalPatterns []*TemporalPattern     `json:"temporal_patterns"`
	TrendAnalysis    *TrendAnalysis         `json:"trend_analysis,omitempty"`
	CausalChains     []*CausalChain         `json:"causal_chains,omitempty"`
	Metadata         map[string]interface{} `json:"metadata"`
}

// TemporalMemory 时序记忆单元
type TemporalMemory struct {
	ID              string                 `json:"id"`
	Content         string                 `json:"content"`
	Timestamp       time.Time              `json:"timestamp"`
	MemoryType      string                 `json:"memory_type"` // event/knowledge/habit
	RelevanceScore  float64                `json:"relevance_score"`
	TemporalScore   float64                `json:"temporal_score"`
	DecayScore      float64                `json:"decay_score"`
	FinalScore      float64                `json:"final_score"`
	Source          string                 `json:"source"` // vector/timeline/knowledge
	Metadata        map[string]interface{} `json:"metadata"`
}

// TemporalPattern 时序模式
type TemporalPattern struct {
	PatternType  string    `json:"pattern_type"` // periodic/trend/burst/anomaly
	Description  string    `json:"description"`
	Confidence   float64   `json:"confidence"`
	TimeSpan     TimeRange `json:"time_span"`
	Frequency    string    `json:"frequency,omitempty"` // daily/weekly/monthly
	RelatedEvents []string `json:"related_events"`
}

// TrendAnalysis 趋势分析
type TrendAnalysis struct {
	Metric      string    `json:"metric"`
	Direction   string    `json:"direction"` // increasing/decreasing/stable
	Strength    float64   `json:"strength"`  // 0-1
	StartTime   time.Time `json:"start_time"`
	EndTime     time.Time `json:"end_time"`
	DataPoints  []DataPoint `json:"data_points"`
	Prediction  *Prediction `json:"prediction,omitempty"`
}

// DataPoint 数据点
type DataPoint struct {
	Timestamp time.Time `json:"timestamp"`
	Value     float64   `json:"value"`
	Label     string    `json:"label,omitempty"`
}

// Prediction 预测
type Prediction struct {
	NextValue     float64   `json:"next_value"`
	Confidence    float64   `json:"confidence"`
	PredictedTime time.Time `json:"predicted_time"`
}

// CausalChain 因果链
type CausalChain struct {
	Cause       *TemporalMemory `json:"cause"`
	Effect      *TemporalMemory `json:"effect"`
	TimeDelta   time.Duration   `json:"time_delta"`
	Confidence  float64         `json:"confidence"`
	Explanation string          `json:"explanation"`
}

// NewTemporalMemoryEngine 创建时序记忆引擎
func NewTemporalMemoryEngine(
	vectorRetriever VectorRetriever,
	timelineRetriever TimelineRetriever,
	knowledgeRetriever KnowledgeRetriever,
) *TemporalMemoryEngine {
	return &TemporalMemoryEngine{
		vectorRetriever:    vectorRetriever,
		timelineRetriever:  timelineRetriever,
		knowledgeRetriever: knowledgeRetriever,
		patternAnalyzer:    NewTemporalPatternAnalyzer(),
		decayModel:         NewMemoryDecayModel(),
		weightAdjuster:     NewAdaptiveWeightAdjuster(),
	}
}

// Retrieve 多维时序记忆检索（核心方法）
func (tme *TemporalMemoryEngine) Retrieve(ctx context.Context, req *TemporalMemoryRequest) (*TemporalMemoryResult, error) {
	log.Printf("🧠 [时序记忆] 开始检索: query=%s, intent=%s", req.Query, req.QueryIntent)

	// 1. 自适应权重计算
	weights := tme.weightAdjuster.CalculateWeights(req.QueryIntent, req.TimeContext)
	log.Printf("📊 [权重调整] vector=%.2f, timeline=%.2f, knowledge=%.2f",
		weights.Vector, weights.Timeline, weights.Knowledge)

	// 2. 并行多维检索
	memories, err := tme.parallelRetrieve(ctx, req, weights)
	if err != nil {
		return nil, fmt.Errorf("多维检索失败: %w", err)
	}

	// 3. 记忆衰减计算
	tme.applyMemoryDecay(memories, req.TimeContext)

	// 4. 时序模式识别
	patterns := tme.patternAnalyzer.AnalyzePatterns(memories)

	// 5. 趋势分析（如果是趋势查询）
	var trendAnalysis *TrendAnalysis
	if req.QueryIntent == "trend" {
		trendAnalysis = tme.analyzeTrend(memories, req.Query)
	}

	// 6. 因果推理（如果是因果查询）
	var causalChains []*CausalChain
	if req.QueryIntent == "causal" {
		causalChains = tme.inferCausalChains(memories)
	}

	// 7. 最终排序（综合所有分数）
	tme.finalRanking(memories)

	// 8. 截断到limit
	if len(memories) > req.Limit {
		memories = memories[:req.Limit]
	}

	log.Printf("✅ [时序记忆] 检索完成: 返回%d条记忆, %d个模式", len(memories), len(patterns))

	return &TemporalMemoryResult{
		Memories:         memories,
		TemporalPatterns: patterns,
		TrendAnalysis:    trendAnalysis,
		CausalChains:     causalChains,
		Metadata: map[string]interface{}{
			"weights":       weights,
			"total_recalled": len(memories),
		},
	}, nil
}

// parallelRetrieve 并行多维检索
func (tme *TemporalMemoryEngine) parallelRetrieve(
	ctx context.Context,
	req *TemporalMemoryRequest,
	weights *DimensionWeights,
) ([]*TemporalMemory, error) {
	type retrievalResult struct {
		memories []*TemporalMemory
		err      error
	}

	vectorChan := make(chan retrievalResult, 1)
	timelineChan := make(chan retrievalResult, 1)
	knowledgeChan := make(chan retrievalResult, 1)

	// 并行检索三个维度
	go func() {
		memories, err := tme.retrieveFromVector(ctx, req)
		vectorChan <- retrievalResult{memories, err}
	}()

	go func() {
		memories, err := tme.retrieveFromTimeline(ctx, req)
		timelineChan <- retrievalResult{memories, err}
	}()

	go func() {
		memories, err := tme.retrieveFromKnowledge(ctx, req)
		knowledgeChan <- retrievalResult{memories, err}
	}()

	// 收集结果
	vectorResult := <-vectorChan
	timelineResult := <-timelineChan
	knowledgeResult := <-knowledgeChan

	// 合并结果
	allMemories := make([]*TemporalMemory, 0)

	if vectorResult.err == nil {
		for _, m := range vectorResult.memories {
			m.RelevanceScore *= weights.Vector
			allMemories = append(allMemories, m)
		}
	}

	if timelineResult.err == nil {
		for _, m := range timelineResult.memories {
			m.RelevanceScore *= weights.Timeline
			allMemories = append(allMemories, m)
		}
	}

	if knowledgeResult.err == nil {
		for _, m := range knowledgeResult.memories {
			m.RelevanceScore *= weights.Knowledge
			allMemories = append(allMemories, m)
		}
	}

	// 去重（基于ID）
	allMemories = tme.deduplicateMemories(allMemories)

	return allMemories, nil
}

// applyMemoryDecay 应用记忆衰减模型
func (tme *TemporalMemoryEngine) applyMemoryDecay(memories []*TemporalMemory, timeContext *TimeContext) {
	referenceTime := time.Now()
	if timeContext != nil && !timeContext.ReferenceTime.IsZero() {
		referenceTime = timeContext.ReferenceTime
	}

	for _, memory := range memories {
		memory.DecayScore = tme.decayModel.CalculateDecay(memory.Timestamp, referenceTime)
		memory.TemporalScore = memory.RelevanceScore * memory.DecayScore
	}
}

// finalRanking 最终排序
func (tme *TemporalMemoryEngine) finalRanking(memories []*TemporalMemory) {
	for _, memory := range memories {
		// 最终分数 = 相关性分数 * 衰减分数
		memory.FinalScore = memory.TemporalScore
	}

	// 按最终分数降序排序
	sort.Slice(memories, func(i, j int) bool {
		return memories[i].FinalScore > memories[j].FinalScore
	})
}

