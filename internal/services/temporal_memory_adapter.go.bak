// CreateTemporalMemoryEngine 创建时序记忆引擎（工厂方法）
func CreateTemporalMemoryEngine(
	vectorStore models.VectorStore,
	timelineEngine interface{},
	knowledgeStore interface{},
) *TemporalMemoryEngine {
	// 创建适配器
	vectorRetriever := &VectorRetrieverAdapter{
		vectorStore: vectorStore,
	}

	timelineRetriever := &TimelineRetrieverAdapter{
		timelineEngine: timelineEngine,
	}

	knowledgeRetriever := &KnowledgeRetrieverAdapter{
		knowledgeStore: knowledgeStore,
	}

	// 创建时序记忆引擎
	engine := NewTemporalMemoryEngine(
		vectorRetriever,
		timelineRetriever,
		knowledgeRetriever,
	)

	log.Printf("✅ [时序记忆引擎] 创建成功")
	return engine
}

// ConvertToContextResponse 将时序记忆结果转换为ContextResponse
func ConvertToContextResponse(result *TemporalMemoryResult, req models.RetrieveContextRequest) models.ContextResponse {
	// 转换记忆为SearchResult格式
	searchResults := make([]models.SearchResult, 0, len(result.Memories))
	for _, memory := range result.Memories {
		searchResults = append(searchResults, models.SearchResult{
			ID:        memory.ID,
			Content:   memory.Content,
			Score:     memory.FinalScore,
			Timestamp: memory.Timestamp,
			Metadata: map[string]interface{}{
				"memory_type":     memory.MemoryType,
				"relevance_score": memory.RelevanceScore,
				"temporal_score":  memory.TemporalScore,
				"decay_score":     memory.DecayScore,
				"source":          memory.Source,
			},
		})
	}

	// 构建响应
	response := models.ContextResponse{
		Context:   searchResults,
		SessionID: req.SessionID,
		Metadata: map[string]interface{}{
			"temporal_enabled":   true,
			"total_memories":     len(result.Memories),
			"temporal_patterns":  len(result.TemporalPatterns),
			"has_trend_analysis": result.TrendAnalysis != nil,
			"has_causal_chains":  len(result.CausalChains) > 0,
		},
	}

	// 添加时序模式信息
	if len(result.TemporalPatterns) > 0 {
		patterns := make([]map[string]interface{}, 0, len(result.TemporalPatterns))
		for _, pattern := range result.TemporalPatterns {
			patterns = append(patterns, map[string]interface{}{
				"type":        pattern.PatternType,
				"description": pattern.Description,
				"confidence":  pattern.Confidence,
				"frequency":   pattern.Frequency,
			})
		}
		response.Metadata["patterns"] = patterns
	}

	// 添加趋势分析信息
	if result.TrendAnalysis != nil {
		response.Metadata["trend"] = map[string]interface{}{
			"metric":    result.TrendAnalysis.Metric,
			"direction": result.TrendAnalysis.Direction,
			"strength":  result.TrendAnalysis.Strength,
		}
	}

	// 添加因果链信息
	if len(result.CausalChains) > 0 {
		chains := make([]map[string]interface{}, 0, len(result.CausalChains))
		for _, chain := range result.CausalChains {
			chains = append(chains, map[string]interface{}{
				"cause":       chain.Cause.Content,
				"effect":      chain.Effect.Content,
				"time_delta":  chain.TimeDelta.String(),
				"confidence":  chain.Confidence,
				"explanation": chain.Explanation,
			})
		}
		response.Metadata["causal_chains"] = chains
	}

	return response
}

// IdentifyQueryIntent 识别查询意图
func IdentifyQueryIntent(query string, analysisResult *models.SemanticAnalysisResult) string {
	// 基于语义分析结果识别意图
	if analysisResult != nil {
		switch analysisResult.Intent {
		case models.IntentRecall:
			return "recall"
		case models.IntentKnowledge:
			return "knowledge"
		case models.IntentTrend:
			return "trend"
		case models.IntentCausal:
			return "causal"
		}
	}

	// 基于关键词识别
	query = query
	// 回忆类关键词
	recallKeywords := []string{"上周", "昨天", "最近", "之前", "什么时候", "哪天", "去了"}
	for _, keyword := range recallKeywords {
		if contains(query, keyword) {
			return "recall"
		}
	}

	// 趋势类关键词
	trendKeywords := []string{"趋势", "变化", "上升", "下降", "增长", "减少", "最近怎么样"}
	for _, keyword := range trendKeywords {
		if contains(query, keyword) {
			return "trend"
		}
	}

	// 因果类关键词
	causalKeywords := []string{"因为", "导致", "影响", "改善", "恶化", "之后", "效果"}
	for _, keyword := range causalKeywords {
		if contains(query, keyword) {
			return "causal"
		}
	}

	// 知识类关键词
	knowledgeKeywords := []string{"是什么", "怎么", "为什么", "如何", "有哪些", "并发症"}
	for _, keyword := range knowledgeKeywords {
		if contains(query, keyword) {
			return "knowledge"
		}
	}

	// 默认为回忆类
	return "default"
}

// contains 检查字符串是否包含子串
func contains(s, substr string) bool {
	return len(s) >= len(substr) && (s == substr || len(s) > len(substr) &&
		(s[:len(substr)] == substr || s[len(s)-len(substr):] == substr ||
		findSubstring(s, substr)))
}

func findSubstring(s, substr string) bool {
	for i := 0; i <= len(s)-len(substr); i++ {
		if s[i:i+len(substr)] == substr {
			return true
		}
	}
	return false
}

// ExtractTimeContext 从查询中提取时间上下文
func ExtractTimeContext(query string) *TimeContext {
	timeContext := &TimeContext{
		ReferenceTime: time.Now(),
		FocusPeriod:   "all",
	}

	// 识别时间范围关键词
	if contains(query, "最近") || contains(query, "近期") {
		timeContext.FocusPeriod = "recent"
		// 最近默认为7天
		startTime := time.Now().AddDate(0, 0, -7)
		timeContext.TimeRange = &TimeRange{
			StartTime: startTime,
			EndTime:   time.Now(),
		}
	} else if contains(query, "上周") {
		timeContext.FocusPeriod = "week"
		startTime := time.Now().AddDate(0, 0, -7)
		timeContext.TimeRange = &TimeRange{
			StartTime: startTime,
			EndTime:   time.Now(),
		}
	} else if contains(query, "上个月") || contains(query, "这个月") {
		timeContext.FocusPeriod = "month"
		startTime := time.Now().AddDate(0, -1, 0)
		timeContext.TimeRange = &TimeRange{
			StartTime: startTime,
			EndTime:   time.Now(),
		}
	} else if contains(query, "今年") || contains(query, "去年") {
		timeContext.FocusPeriod = "year"
		startTime := time.Now().AddDate(-1, 0, 0)
		timeContext.TimeRange = &TimeRange{
			StartTime: startTime,
			EndTime:   time.Now(),
		}
	}

	return timeContext
}
