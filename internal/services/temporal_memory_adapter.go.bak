// TemporalMemoryAdapter 时序记忆适配器
// 将现有的三个检索器适配为时序记忆引擎所需的接口
type TemporalMemoryAdapter struct {
	vectorStore    models.VectorStore
	timelineEngine interface{} // timeline.TimescaleDBEngine
	knowledgeStore interface{} // knowledge.Neo4jStore
}

// NewTemporalMemoryAdapter 创建时序记忆适配器
func NewTemporalMemoryAdapter(
	vectorStore models.VectorStore,
	timelineEngine interface{},
	knowledgeStore interface{},
) *TemporalMemoryAdapter {
	return &TemporalMemoryAdapter{
		vectorStore:    vectorStore,
		timelineEngine: timelineEngine,
		knowledgeStore: knowledgeStore,
	}
}

// VectorRetrieverAdapter 向量检索器适配器
type VectorRetrieverAdapter struct {
	vectorStore models.VectorStore
}

// Search 实现VectorRetriever接口
func (vra *VectorRetrieverAdapter) Search(ctx context.Context, query string, limit int) ([]*TemporalMemory, error) {
	// 调用现有的向量检索
	results, err := vra.vectorStore.Search(ctx, models.SearchRequest{
		Query: query,
		Limit: limit,
	})
	if err != nil {
		return nil, fmt.Errorf("向量检索失败: %w", err)
	}

	// 转换为TemporalMemory格式
	memories := make([]*TemporalMemory, 0, len(results))
	for _, r := range results {
		memories = append(memories, &TemporalMemory{
			ID:             r.ID,
			Content:        r.Content,
			Timestamp:      r.Timestamp,
			MemoryType:     "event",
			RelevanceScore: r.Score,
			Source:         "vector",
			Metadata: map[string]interface{}{
				"session_id": r.SessionID,
				"role":       r.Role,
			},
		})
	}

	log.Printf("🔍 [向量检索] 检索到 %d 条记忆", len(memories))
	return memories, nil
}

