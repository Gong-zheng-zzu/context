# Full System: 完整系统配置（启用所有安全防护）
# 对应 experiments/configs/full_system.yaml

# LLM配置
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b

# 启用完整安全模块（PCCM + CASIA + ASDF）
SECURITY_ENABLE_MULTI_LAYER=true
SECURITY_CONFIG_PATH=/app/config/security_policy.yaml
SECURITY_AUDIT_LOG_PATH=/app/data/security_audit.log
SECURITY_ENCRYPTION_SECRET=full_system_secret_key_32_characters_minimum

# 启用三路检索融合（向量+图谱+时序）
VECTOR_STORE_ENABLED=true
GRAPH_STORE_ENABLED=true
TIMELINE_ENABLED=true

# 多维度存储引擎配置（新增：与 database_config.go 对齐）
TIMELINE_STORAGE_ENABLED=true
KNOWLEDGE_GRAPH_ENABLED=true
VECTOR_STORAGE_ENABLED=true
MULTI_DIM_VECTOR_ENABLED=true

# 多维度检索LLM配置
MULTI_DIM_LLM_PROVIDER=ollama_local
MULTI_DIM_LLM_MODEL=qwen2.5:3b

# 知识图谱抽取模式（enhanced_prompt | parallel_dedicated | disabled）
KNOWLEDGE_GRAPH_EXTRACTION_MODE=enhanced_prompt

# 向量数据库配置
VECTOR_DB_URL=http://qdrant:6333
VECTOR_DB_COLLECTION=nursing_records
VECTOR_STORE_TYPE=qdrant
VECTOR_DB_METRIC=cosine

# TimescaleDB配置（时间线存储）
TIMESCALEDB_HOST=timescaledb
TIMESCALEDB_PORT=5432
TIMESCALEDB_DATABASE=context_keeper_timeline
TIMESCALEDB_USERNAME=context_keeper
TIMESCALEDB_PASSWORD=context_keeper_password
TIMESCALEDB_SSLMODE=disable
TIMESCALEDB_SSL_MODE=disable
TIMESCALEDB_MAX_CONNS=10
TIMESCALEDB_MAX_IDLE_TIME=30m
TIMELINE_DEFAULT_WINDOW=90 days

# Neo4j配置（知识图谱存储）
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j_password
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=30s
NEO4J_MAX_TRANSACTION_RETRY_TIME=30s

# Embedding配置（使用Ollama生成embedding）
# EMBEDDING_API_URL=http://embedding:8080
# EMBEDDING_API_KEY=

# 服务端口
HTTP_SERVER_PORT=8088
HOST=0.0.0.0

# 其他配置
GIN_MODE=release
USER_REPOSITORY_TYPE=memory
EXPERIMENT_STRUCTURED_THREEWAY_ENABLED=true
RATE_LIMIT_PER_MIN=1000
RATE_LIMIT_BURST=1000
