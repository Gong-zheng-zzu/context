# Baseline 3: RAG+规则过滤配置（向量检索+基础过滤）
# 对应 experiments/configs/baseline_rag_with_filter.yaml

# LLM配置
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b

# 部分启用安全模块（仅基础检测，无多层防御）
SECURITY_ENABLE_MULTI_LAYER=false
SECURITY_CONFIG_PATH=/app/config/security_policy.yaml
SECURITY_AUDIT_LOG_PATH=/app/data/security_audit.log
SECURITY_ENCRYPTION_SECRET=baseline_rag_filter_secret_key_32chars_min

# 启用向量检索，关闭图谱和时序
VECTOR_STORE_ENABLED=true
GRAPH_STORE_ENABLED=false
TIMELINE_ENABLED=false
TIMELINE_DEFAULT_WINDOW=90 days

# 向量数据库配置
VECTOR_DB_URL=http://qdrant:6333
VECTOR_DB_COLLECTION=nursing_records
VECTOR_STORE_TYPE=qdrant
VECTOR_DB_METRIC=cosine

# Neo4j配置（关闭）
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j_password

# Embedding配置（使用Ollama生成embedding）
# EMBEDDING_API_URL=http://embedding:8080
# EMBEDDING_API_KEY=

# 服务端口
HTTP_SERVER_PORT=8088
HOST=0.0.0.0

# 其他配置
GIN_MODE=release
USER_REPOSITORY_TYPE=memory
RETRIEVAL_RULE_FILTER_ENABLED=true
RETRIEVAL_RULE_FILTER_RULESET=/app/config/retrieval_filter_baseline.json
