# Full System: 完整系统配置（启用所有安全防护）
# 对应 experiments/configs/full_system.yaml

# LLM配置
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b

# 启用完整安全模块（PCCM + CASIA + ASDF）
SECURITY_ENABLE_MULTI_LAYER=true
SECURITY_CONFIG_PATH=/app/config/security_policy.yaml
SECURITY_AUDIT_LOG_PATH=/app/data/security_audit.log
SECURITY_ENCRYPTION_SECRET=full_system_secret_key_32_characters_minimum

# 启用三路检索融合（向量+图谱+时序）
VECTOR_STORE_ENABLED=true
GRAPH_STORE_ENABLED=true
TIMELINE_ENABLED=true
TIMELINE_DEFAULT_WINDOW=90 days

# 向量数据库配置
VECTOR_DB_URL=http://qdrant:6333
VECTOR_DB_COLLECTION=nursing_records
VECTOR_STORE_TYPE=qdrant
VECTOR_DB_METRIC=cosine

# Neo4j配置（启用）
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j_password

# Embedding配置（使用Ollama生成embedding）
# EMBEDDING_API_URL=http://embedding:8080
# EMBEDDING_API_KEY=

# 服务端口
HTTP_SERVER_PORT=8088
HOST=0.0.0.0

# 其他配置
GIN_MODE=release
USER_REPOSITORY_TYPE=memory
EXPERIMENT_STRUCTURED_THREEWAY_ENABLED=true
RATE_LIMIT_PER_MIN=1000
RATE_LIMIT_BURST=1000
