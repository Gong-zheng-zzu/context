[
  {
    "id": "rule-001",
    "name": "高危凭证检测",
    "description": "检测 API 密钥、密码、私钥等高危凭证",
    "sensitive_types": [
      "api_key",
      "password",
      "private_key",
      "aws_key",
      "secret_key"
    ],
    "security_level": "high",
    "actions": [
