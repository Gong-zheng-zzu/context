# Context-Keeper competition demo configuration
# Copy to `.env` or merge into your existing local `.env`.
# Do not commit real keys.

SERVICE_NAME=context-keeper
PORT=8088
HOST=0.0.0.0
DEBUG=false
GIN_MODE=release
STORAGE_PATH=./data

# Auth
JWT_SECRET=replace-with-a-random-32-plus-char-secret
SECURITY_ENCRYPTION_SECRET=replace-with-a-separate-random-32-plus-char-secret
DEMO_AUTH_PASSWORD=replace-with-demo-password
# Optional: DEMO_AUTH_CREDENTIALS=doctor_001:demo-pass,caregiver_001:demo-pass
# Optional: DEMO_AUTH_ROLE_CREDENTIALS=doctor_001:demo-pass:doctor,caregiver_001:demo-pass:caregiver

# Retrieval storage
VECTOR_STORE_TYPE=qdrant
USER_REPOSITORY_TYPE=memory
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=context_keeper
QDRANT_DIMENSION=768
QDRANT_METRIC=cosine
SIMILARITY_THRESHOLD=0.3

# Embedding
EMBEDDING_API_URL=http://host.docker.internal:11434/api/embeddings
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=not_required

# LLM
LLM_PROVIDER=ollama_local
LLM_MODEL=qwen2.5:7b
LLM_MAX_TOKENS=80000
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=1200
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
QIANWEN_API_KEY=

# Security
SECURITY_ENABLED=true
SECURITY_MODE=multi_layer
SECURITY_ENABLE_MULTI_LAYER=true
SECURITY_REDACT_ENABLED=true
SECURITY_AUDIT_ENABLED=true

# HTTP protection
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_BURST=100
ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://localhost:8889
