# Context-Keeper 环境变量配置模板
# 复制此文件为 .env 并填写实际配置值

# =================================
# 基础服务配置
# =================================
SERVICE_NAME=context-keeper
PORT=8088
DEBUG=false
STORAGE_PATH=./data
JWT_SECRET=change-this-before-deploy
SECURITY_ENCRYPTION_SECRET=change-this-storage-secret
SECURITY_ENABLE_MULTI_LAYER=false
DEMO_AUTH_PASSWORD=change-this-demo-password
# Optional: DEMO_AUTH_CREDENTIALS=doctor_001:secret,caregiver_001:secret
# Optional: DEMO_AUTH_ROLE_CREDENTIALS=doctor_001:secret:doctor,caregiver_001:secret:caregiver

# =================================
# Embedding服务配置
# =================================

# 选项1: 本地 Ollama 嵌入服务（推荐）
EMBEDDING_API_URL=http://host.docker.internal:11434/api/embeddings
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=not_required

# 选项2: 阿里云DashScope嵌入服务（云端）
# EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
# EMBEDDING_API_KEY=your_dashscope_api_key

# 批量Embedding配置
BATCH_QUEUE_SIZE=100
BATCH_WORKER_POLL_INTERVAL=5s
BATCH_MAX_RETRIES=100

# =================================
# 向量存储配置
# =================================

# 向量存储类型选择: aliyun | vearch | qdrant
VECTOR_STORE_TYPE=qdrant

# 选项1: Qdrant 本地向量数据库（推荐）
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=context_keeper
QDRANT_DIMENSION=768
QDRANT_METRIC=cosine
SIMILARITY_THRESHOLD=0.3

# 选项2: 阿里云DashVector向量数据库
# VECTOR_DB_URL=https://your-instance.dashvector.cn-hangzhou.aliyuncs.com
# VECTOR_DB_API_KEY=your_dashvector_api_key
# VECTOR_DB_COLLECTION=context_keeper
# VECTOR_DB_DIMENSION=1536
# VECTOR_DB_METRIC=cosine
# SIMILARITY_THRESHOLD=0.3

# 选项3: 京东云Vearch向量数据库
# VEARCH_URL=http://your-vearch-instance.jd.local
# VEARCH_USERNAME=your_username
# VEARCH_PASSWORD=your_password
# VEARCH_DATABASE=db
# VEARCH_DIMENSION=1536
# VEARCH_METRIC=inner_product
# VEARCH_SIMILARITY_THRESHOLD=0.2
# VEARCH_REQUIRED_SPACES=context_keeper_vector,context_keeper_users
# VEARCH_CONNECTION_POOL_SIZE=10
# VEARCH_REQUEST_TIMEOUT=30
# VEARCH_DEFAULT_TOP_K=10

# =================================
# 会话管理配置
# =================================
SESSION_TIMEOUT=720m            # 会话超时时间（分钟）
CLEANUP_INTERVAL=30m            # 后台清理任务执行间隔
SHORT_MEMORY_MAX_AGE=2          # 短期记忆保留天数

# 自动汇总配置
SUMMARY_INTERVAL_MULTIPLIER=5   # 自动汇总间隔倍数
MIN_MESSAGE_COUNT=20            # 最小消息数阈值
MIN_TIME_SINCE_LAST_SUMMARY=24  # 距离上次汇总的最小小时数
MAX_MESSAGE_COUNT=100           # 触发汇总的消息数阈值

USER_REPOSITORY_TYPE=memory

# =================================
# LLM配置（核心）
# =================================

# LLM驱动功能总开关
LLM_DRIVEN_ENABLED=true
LLM_DRIVEN_SEMANTIC_ANALYSIS=false
LLM_DRIVEN_MULTI_DIMENSIONAL=false
LLM_DRIVEN_CONTENT_SYNTHESIS=false

# LLM提供商配置
# 选项1: 本地Ollama（推荐）
LLM_PROVIDER=ollama_local
LLM_MODEL=qwen2.5:7b
# 其他可选模型: deepseek-coder-v2:16b, codeqwen:7b, deepseek-coder:33b

# 选项2: 云端DeepSeek
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat

# 选项3: OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-3.5-turbo

# LLM通用配置
LLM_MAX_TOKENS=80000
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=1200

# 语料分析策略配置
SEMANTIC_ANALYSIS_STRATEGY=lightweight        # lightweight | deepIntent
ENABLE_STRATEGY_COMPARISON=false              # 是否开启策略对比模式

# =================================
# LLM API Keys配置
# =================================

# DeepSeek API Key（如使用云端DeepSeek）
DEEPSEEK_API_KEY=

# 其他LLM提供商API密钥（可选）
OPENAI_API_KEY=
CLAUDE_API_KEY=
QIANWEN_API_KEY=

# =================================
# 多维度存储配置（高级功能）
# =================================
ENABLE_MULTI_DIMENSIONAL_STORAGE=false
MULTI_DIM_TIMELINE_ENABLED=false
MULTI_DIM_KNOWLEDGE_ENABLED=false
MULTI_DIM_VECTOR_ENABLED=false
MULTI_DIM_LLM_PROVIDER=ollama_local
MULTI_DIM_LLM_MODEL=qwen2.5:7b
MULTI_DIM_LLM_TIMEOUT_SECONDS=600

# MCP工具拦截配置
INTERCEPT_MCP_TOOLS=retrieve_context,store_conversation,retrieve_memory,memorize_context,retrieve_todos

# 知识图谱提取模式
KNOWLEDGE_GRAPH_EXTRACTION_MODE=enhanced_prompt
LLM_DRIVEN_SHORT_TERM_MEMORY=true

# =================================
# 时间线存储配置（TimescaleDB/PostgreSQL）
# =================================
TIMELINE_STORAGE_ENABLED=true

# TimescaleDB连接配置（Docker环境使用容器名，本地环境使用localhost）
TIMESCALEDB_HOST=timescaledb
TIMESCALEDB_PORT=5432
TIMESCALEDB_DATABASE=context_keeper_timeline
TIMESCALEDB_USERNAME=context_keeper
TIMESCALEDB_PASSWORD=context_keeper_password
TIMESCALEDB_SSL_MODE=disable

# 连接池配置
TIMESCALEDB_MAX_CONNS=10
TIMESCALEDB_MAX_IDLE_TIME=5m

# =================================
# 知识图谱存储配置（Neo4j）
# =================================
KNOWLEDGE_GRAPH_ENABLED=true

# Neo4j连接配置（Docker环境使用容器名，本地环境使用localhost）
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j_password
NEO4J_DATABASE=neo4j

# Neo4j连接池配置
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=30s
NEO4J_MAX_TRANSACTION_RETRY_TIME=15s

# =================================
# 安全配置
# =================================
SECURITY_ENABLED=true
SECURITY_MODE=multi_layer
SECURITY_REDACT_ENABLED=true
SECURITY_AUDIT_ENABLED=true
