<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>忆安智护 - 医生端</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
            background: linear-gradient(135deg, #E8EDF5 0%, #D0D9E8 100%);
            height: 100vh;
            overflow: hidden;
        }

        .container {
            display: flex;
            height: 100vh;
        }

        /* 侧边栏 */
        .sidebar {
            width: 280px;
            background: linear-gradient(180deg, #ffffff 0%, #F0F2F8 100%);
            border-right: 1px solid #8A9FBF;
            display: flex;
            flex-direction: column;
            box-shadow: 2px 0 10px rgba(33, 150, 243, 0.1);
        }

        .sidebar-header {
            padding: 20px;
            border-bottom: 1px solid #e0e0e0;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 15px;
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #3B5998 0%, #4A6BA8 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            box-shadow: 0 4px 12px rgba(59, 89, 152, 0.3);
        }

        .logo-text {
            font-size: 18px;
            font-weight: 600;
            color: #2c3e50;
        }

        .new-chat-btn {
            width: 100%;
            background: linear-gradient(135deg, #3B5998 0%, #4A6BA8 100%);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 12px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 12px rgba(59, 89, 152, 0.3);
        }

        .new-chat-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(59, 89, 152, 0.4);
        }

        .chat-history {
            flex: 1;
            overflow-y: auto;
            padding: 10px;
        }

        .history-item {
            padding: 12px 15px;
            border-radius: 10px;
            margin-bottom: 8px;
            cursor: pointer;
            transition: background 0.2s ease;
            font-size: 14px;
            color: #2c3e50;
        }

        .history-item:hover {
            background: #f5f5f5;
        }

        .history-item.active {
            background: linear-gradient(135deg, #E8EDF5 0%, #D0D9E8 100%);
            color: #2E4A7C;
            font-weight: 600;
            border-left: 3px solid #3B5998;
        }

        .sidebar-footer {
            padding: 20px;
            border-top: 1px solid #e0e0e0;
        }

        .back-btn {
            width: 100%;
            background: white;
            border: 2px solid #3B5998;
            color: #2E4A7C;
            border-radius: 12px;
            padding: 12px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: block;
            text-align: center;
        }

        .back-btn:hover {
            background: #E8EDF5;
        }

        /* 主聊天区域 */
        .chat-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: white;
        }

        .chat-header {
            padding: 20px 30px;
            border-bottom: 1px solid #e0e0e0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: linear-gradient(135deg, #3B5998 0%, #4A6BA8 100%);
            color: white;
        }

        .chat-title {
            font-size: 20px;
            font-weight: 600;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            background: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #2E4A7C;
            font-weight: 600;
            font-size: 14px;
        }

        /* 消息区域 */
        .messages-container {
            flex: 1;
            overflow-y: auto;
            padding: 30px;
            background: linear-gradient(180deg, #fafafa 0%, #f5f5f5 100%);
        }

        .message {
            display: flex;
            margin-bottom: 24px;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .message.user {
            flex-direction: row-reverse;
        }

        .message-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .message.assistant .message-avatar {
            background: linear-gradient(135deg, #3B5998 0%, #4A6BA8 100%);
            box-shadow: 0 2px 8px rgba(66, 165, 245, 0.3);
        }

        .message.user .message-avatar {
            background: linear-gradient(135deg, #2E4A7C 0%, #3B5998 100%);
            box-shadow: 0 2px 8px rgba(30, 136, 229, 0.3);
        }

        .message-content {
            max-width: 70%;
            margin: 0 15px;
        }

        .message-bubble {
            padding: 15px 18px;
            border-radius: 16px;
            line-height: 1.6;
            font-size: 15px;
        }

        .message.assistant .message-bubble {
            background: white;
            color: #2c3e50;
            border: 1px solid #bbdefb;
            box-shadow: 0 2px 8px rgba(66, 165, 245, 0.1);
        }

        .message.user .message-bubble {
            background: linear-gradient(135deg, #3B5998 0%, #4A6BA8 100%);
            color: white;
            box-shadow: 0 2px 8px rgba(66, 165, 245, 0.3);
        }

        .message-time {
            font-size: 12px;
            color: #95a5a6;
            margin-top: 6px;
            padding: 0 5px;
        }

        /* 欢迎界面 */
        .welcome-screen {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            padding: 40px;
        }

        .welcome-icon {
            font-size: 80px;
            margin-bottom: 20px;
        }

        .welcome-title {
            font-size: 28px;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 12px;
        }

        .welcome-desc {
            font-size: 16px;
            color: #7f8c8d;
            text-align: center;
            margin-bottom: 40px;
            max-width: 600px;
            line-height: 1.6;
        }

        .quick-questions {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            max-width: 600px;
            width: 100%;
        }

        .quick-question {
            background: white;
            border: 2px solid #bbdefb;
            border-radius: 12px;
            padding: 18px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: left;
            box-shadow: 0 2px 8px rgba(66, 165, 245, 0.1);
        }

        .quick-question:hover {
            border-color: #42a5f5;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(66, 165, 245, 0.2);
        }

        .quick-question-icon {
            font-size: 24px;
            margin-bottom: 10px;
        }

        .quick-question-text {
            font-size: 14px;
            color: #2c3e50;
            font-weight: 500;
        }

        /* 输入区域 */
        .input-area {
            padding: 20px 30px;
            border-top: 1px solid #e0e0e0;
            background: white;
        }

        .input-container {
            display: flex;
            gap: 12px;
            align-items: flex-end;
            max-width: 1000px;
            margin: 0 auto;
        }

        .input-wrapper {
            flex: 1;
            position: relative;
        }

        .message-input {
            width: 100%;
            min-height: 50px;
            max-height: 150px;
            padding: 14px 50px 14px 18px;
            border: 2px solid #bbdefb;
            border-radius: 25px;
            font-size: 15px;
            font-family: inherit;
            resize: none;
            outline: none;
            transition: all 0.3s ease;
            box-shadow: 0 2px 8px rgba(66, 165, 245, 0.05);
        }

        .message-input:focus {
            border-color: #42a5f5;
            box-shadow: 0 4px 12px rgba(66, 165, 245, 0.15);
        }

        .message-input::placeholder {
            color: #bdc3c7;
        }

        .attach-btn {
            position: absolute;
            right: 12px;
            bottom: 12px;
            width: 32px;
            height: 32px;
            background: transparent;
            border: none;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            transition: background 0.2s ease;
        }

        .attach-btn:hover {
            background: #E8EDF5;
        }

        .file-input {
            display: none;
        }

        /* 文件上传相关样式 */
        .file-preview-container {
            margin-top: 10px;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .file-preview-item {
            position: relative;
            background: white;
            border: 2px solid #bbdefb;
            border-radius: 12px;
            padding: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
            max-width: 300px;
            box-shadow: 0 2px 8px rgba(66, 165, 245, 0.1);
        }

        .file-preview-icon {
            font-size: 32px;
            flex-shrink: 0;
        }

        .file-preview-info {
            flex: 1;
            min-width: 0;
        }

        .file-preview-name {
            font-size: 14px;
            font-weight: 500;
            color: #2c3e50;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .file-preview-size {
            font-size: 12px;
            color: #95a5a6;
            margin-top: 2px;
        }

        .file-preview-remove {
            width: 24px;
            height: 24px;
            background: #ff6b6b;
            border: none;
            border-radius: 50%;
            color: white;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
            transition: background 0.2s ease;
        }

        .file-preview-remove:hover {
            background: #ff5252;
        }

        .file-message-attachment {
            margin-top: 10px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            padding: 8px 12px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
        }

        .message.user .file-message-attachment {
            background: rgba(255, 255, 255, 0.2);
        }

        .message.assistant .file-message-attachment {
            background: #E8EDF5;
            border: 1px solid #bbdefb;
        }

        .send-btn {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #3B5998 0%, #4A6BA8 100%);
            border: none;
            border-radius: 50%;
            color: white;
            font-size: 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            flex-shrink: 0;
            box-shadow: 0 4px 12px rgba(59, 89, 152, 0.3);
        }

        .send-btn:hover {
            transform: scale(1.1);
            box-shadow: 0 6px 16px rgba(59, 89, 152, 0.4);
        }

        .send-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .input-hint {
            font-size: 12px;
            color: #95a5a6;
            text-align: center;
            margin-top: 10px;
        }

        /* 加载动画 */
        .typing-indicator {
            display: flex;
            gap: 6px;
            padding: 15px 18px;
        }

        .typing-dot {
            width: 8px;
            height: 8px;
            background: #95a5a6;
            border-radius: 50%;
            animation: typing 1.4s infinite;
        }

        .typing-dot:nth-child(2) {
            animation-delay: 0.2s;
        }

        .typing-dot:nth-child(3) {
            animation-delay: 0.4s;
        }

        @keyframes typing {
            0%, 60%, 100% {
                transform: translateY(0);
            }
            30% {
                transform: translateY(-10px);
            }
        }

        /* 响应式设计 */
        @media (max-width: 968px) {
            .sidebar {
                display: none;
            }

            .quick-questions {
                grid-template-columns: 1fr;
            }

            .message-content {
                max-width: 85%;
            }
        }

        /* 滚动条样式 */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #bdc3c7;
            border-radius: 3px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #95a5a6;
        }

        /* 登录界面样式 */
        .login-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #E8EDF5 0%, #D0D9E8 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
        }

        .login-container {
            background: white;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
            max-width: 450px;
            width: 90%;
        }

        .login-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .login-logo {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #3B5998 0%, #4A6BA8 100%);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 40px;
            margin: 0 auto 20px;
        }

        .login-title {
            font-size: 24px;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
        }

        .login-subtitle {
            font-size: 14px;
            color: #7f8c8d;
        }

        .test-users-section {
            margin-top: 30px;
            padding-top: 30px;
            border-top: 2px solid #f0f0f0;
        }

        .test-users-title {
            font-size: 16px;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 15px;
            text-align: center;
        }

        .test-users-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }

        .test-user-btn {
            background: white;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            padding: 15px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }

        .test-user-btn:hover {
            border-color: #42a5f5;
            background: #f1f8ff;
            transform: translateY(-2px);
        }

        .test-user-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: linear-gradient(135deg, #3B5998 0%, #4A6BA8 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .test-user-name {
            font-size: 14px;
            font-weight: 600;
            color: #2c3e50;
        }

        .test-user-id {
            font-size: 11px;
            color: #95a5a6;
        }

        .login-hint {
            text-align: center;
            font-size: 12px;
            color: #95a5a6;
            margin-top: 20px;
        }

        .logout-btn {
            background: transparent;
            border: 2px solid rgba(255, 255, 255, 0.5);
            border-radius: 8px;
            padding: 8px 16px;
            font-size: 13px;
            color: white;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .logout-btn:hover {
            border-color: white;
            background: rgba(255, 255, 255, 0.2);
        }
    </style>
</head>
<body>
    <!-- 登录界面 -->
    <div class="login-overlay" id="loginOverlay">
        <div class="login-container">
            <div class="login-header">
                <div class="login-logo">👨‍⚕️</div>
                <div class="login-title">医生对话端</div>
                <div class="login-subtitle">选择测试用户快速登录</div>
            </div>

            <div class="test-users-section">
                <div class="test-users-title">测试用户快速登录</div>
                <div class="test-users-grid">
                    <button class="test-user-btn" onclick="quickLogin('王医生', 'doctor_wang')">
                        <div class="test-user-avatar">👨‍⚕️</div>
                        <div class="test-user-name">王医生</div>
                        <div class="test-user-id">doctor_wang</div>
                    </button>
                    <button class="test-user-btn" onclick="quickLogin('李医生', 'doctor_li')">
                        <div class="test-user-avatar">👩‍⚕️</div>
                        <div class="test-user-name">李医生</div>
                        <div class="test-user-id">doctor_li</div>
                    </button>
                    <button class="test-user-btn" onclick="quickLogin('张医生', 'doctor_zhang')">
                        <div class="test-user-avatar">👨‍⚕️</div>
                        <div class="test-user-name">张医生</div>
                        <div class="test-user-id">doctor_zhang</div>
                    </button>
                    <button class="test-user-btn" onclick="quickLogin('刘医生', 'doctor_liu')">
                        <div class="test-user-avatar">👩‍⚕️</div>
                        <div class="test-user-name">刘医生</div>
                        <div class="test-user-id">doctor_liu</div>
                    </button>
                </div>
                <div class="login-hint">
                    点击任意用户即可快速登录，无需密码
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <!-- 侧边栏 -->
        <div class="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <div class="logo-icon">👨‍⚕️</div>
                    <div class="logo-text">忆安智护</div>
                </div>
                <button class="new-chat-btn" onclick="newChat()">
                    ➕ 新对话
                </button>
            </div>

            <div class="chat-history" id="chatHistory">
                <!-- 历史记录将通过JavaScript动态加载 -->
            </div>

            <div class="sidebar-footer">
                <a href="/web/role_selection.html" class="back-btn">
                    ← 返回角色选择
                </a>
            </div>
        </div>

        <!-- 主聊天区域 -->
        <div class="chat-main">
            <div class="chat-header">
                <div class="chat-title">👨‍⚕️ 医生对话助手</div>
                <div class="user-info">
                    <div class="user-avatar" id="userAvatar">医生</div>
                    <button class="logout-btn" onclick="logout()">切换用户</button>
                </div>
            </div>

            <div class="messages-container" id="messagesContainer">
                <!-- 欢迎界面 -->
                <div class="welcome-screen" id="welcomeScreen">
                    <div class="welcome-icon">👨‍⚕️</div>
                    <div class="welcome-title">您好！我是医生助手</div>
                    <div class="welcome-desc">
                        我可以帮您查询和分析老人的健康数据，生成趋势图表和健康报告。您可以通过对话方式询问任何健康相关的问题。
                    </div>
                    <div class="quick-questions">
                        <div class="quick-question" onclick="sendQuickQuestion('显示张奶奶最近3天的血压趋势')">
                            <div class="quick-question-icon">📈</div>
                            <div class="quick-question-text">查询健康趋势</div>
                        </div>
                        <div class="quick-question" onclick="sendQuickQuestion('分析李爷爷的健康状况')">
                            <div class="quick-question-icon">📊</div>
                            <div class="quick-question-text">健康状况分析</div>
                        </div>
                        <div class="quick-question" onclick="sendQuickQuestion('王奶奶有哪些异常指标')">
                            <div class="quick-question-icon">⚠️</div>
                            <div class="quick-question-text">异常指标检查</div>
                        </div>
                        <div class="quick-question" onclick="sendQuickQuestion('生成赵爷爷的健康报告')">
                            <div class="quick-question-icon">📋</div>
                            <div class="quick-question-text">生成健康报告</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="input-area">
                <div class="input-container">
                    <div class="input-wrapper">
                        <textarea
                            class="message-input"
                            id="messageInput"
                            placeholder="例如：显示张奶奶最近3天的血压趋势..."
                            rows="1"
                            onkeydown="handleKeyDown(event)"
                            oninput="autoResize(this)"
                        ></textarea>
                        <button class="attach-btn" onclick="attachFile()">📎</button>
                        <input type="file" id="fileInput" class="file-input" accept=".jpg,.jpeg,.png,.pdf,.txt" onchange="handleFileSelect(event)" multiple>
                    </div>
                    <button class="send-btn" id="sendBtn" onclick="sendMessage()">
                        ➤
                    </button>
                </div>
                <div id="filePreviewContainer" class="file-preview-container"></div>
                <div class="input-hint">
                    💡 提示：您可以询问任何老人的健康数据、趋势分析、异常指标等
                </div>
                <div class="input-hint" style="margin-top: 5px; font-size: 11px; color: #7f8c8d;">
                    支持上传：图片(JPG/PNG/GIF)、PDF、文本文件(TXT)、Word文档(DOC/DOCX)
                </div>
            </div>
        </div>
    </div>

    <!-- 配置文件 -->
    <script src="js/config.js"></script>
    <!-- 通用聊天功能 -->
    <script src="js/chat-common.js"></script>
    <script>
        // 附件功能
        function attachFile() {
            document.getElementById('fileInput').click();
        }

        // 处理文件选择
        function handleFileSelect(event) {
            const files = Array.from(event.target.files);

            // 验证文件
            for (const file of files) {
                // 检查文件大小（限制10MB）
                const maxSize = 10 * 1024 * 1024;
                if (file.size > maxSize) {
                    alert(`文件 ${file.name} 大小超过10MB限制`);
                    continue;
                }

                // 检查文件类型
                const allowedTypes = ['.jpg', '.jpeg', '.png', '.gif', '.bmp', '.pdf', '.doc', '.docx', '.txt'];
                const fileExt = '.' + file.name.split('.').pop().toLowerCase();
                if (!allowedTypes.includes(fileExt)) {
                    alert(`文件 ${file.name} 类型不支持`);
                    continue;
                }

                // 添加到选中文件列表
                selectedFiles.push(file);
            }

            // 更新文件预览
            updateFilePreview();

            // 清空input，允许重复选择同一文件
            event.target.value = '';
        }

        // 更新文件预览
        function updateFilePreview() {
            const container = document.getElementById('filePreviewContainer');
            container.innerHTML = '';

            selectedFiles.forEach((file, index) => {
                const fileItem = document.createElement('div');
                fileItem.className = 'file-preview-item';

                const fileIcon = getFileIcon(file.name);
                const fileSize = formatFileSize(file.size);

                fileItem.innerHTML = `
                    <div class="file-preview-icon">${fileIcon}</div>
                    <div class="file-preview-info">
                        <div class="file-preview-name">${file.name}</div>
                        <div class="file-preview-size">${fileSize}</div>
                    </div>
                    <button class="file-preview-remove" onclick="removeFile(${index})">×</button>
                `;

                container.appendChild(fileItem);
            });
        }

        // 移除文件
        function removeFile(index) {
            selectedFiles.splice(index, 1);
            updateFilePreview();
        }

        // 获取文件图标
        function getFileIcon(filename) {
            const ext = filename.split('.').pop().toLowerCase();
            const iconMap = {
                'jpg': '🖼️', 'jpeg': '🖼️', 'png': '🖼️', 'gif': '🖼️', 'bmp': '🖼️',
                'pdf': '📄',
                'doc': '📝', 'docx': '📝',
                'txt': '📃'
            };
            return iconMap[ext] || '📎';
        }

        // 格式化文件大小
        function formatFileSize(bytes) {
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(2) + ' KB';
            return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
        }

        // 医生端特定配置
        const ROLE_CONFIG = {
            role: 'doctor',
            roleName: '医生',
            systemPrompt: `你是养老院医生助手。你的职责是：
1. 帮助医生查询和分析老人健康数据
2. 生成趋势图表和健康报告
3. 识别异常数据并给出诊断建议
4. 回答医疗相关问题

当用户询问"XXX最近血压趋势"时，你要：
- 查询 InfluxDB 获取历史数据
- 生成趋势图表
- 分析数据并给出专业建议

回复要专业准确，使用医学术语，提供数据支持的分析。`,
            quickQuestions: [
                { icon: '📈', text: '查询健康趋势', question: '显示张奶奶最近3天的血压趋势' },
                { icon: '📊', text: '健康状况分析', question: '分析李爷爷的健康状况' },
                { icon: '⚠️', text: '异常指标检查', question: '王奶奶有哪些异常指标' },
                { icon: '📋', text: '生成健康报告', question: '生成赵爷爷的健康报告' }
            ]
        };

        // 初始化
        initializeChat(ROLE_CONFIG);
    </script>
</body>
</html>
