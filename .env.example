# =================================
# Basic Service Configuration
# =================================

# Service name identifier
SERVICE_NAME=context-keeper

# HTTP server port
PORT=8088

# Debug mode (true/false) - enables verbose logging
DEBUG=false

# Data storage path - local directory for storing session data
STORAGE_PATH=./data

# Server host binding
HOST=0.0.0.0

# Gin mode: debug, release, test
GIN_MODE=release

# Enable HTTP mode for development/testing (true/false)
# HTTP_MODE=true
# STREAMABLE_HTTP_MODE=true

# Security secrets
JWT_SECRET=replace-with-a-random-32-plus-char-secret
SECURITY_ENCRYPTION_SECRET=replace-with-a-separate-random-32-plus-char-secret
SECURITY_ENABLE_MULTI_LAYER=false


# =================================
# Vector Store Configuration (Required)
# =================================

# Vector store type: aliyun (DashVector) | vearch (JD Cloud)
VECTOR_STORE_TYPE=aliyun

# --- Aliyun DashVector Configuration ---
# DashVector instance URL
VECTOR_DB_URL=https://your-instance.dashvector.cn-hangzhou.aliyuncs.com

# DashVector API key
VECTOR_DB_API_KEY=your-dashvector-api-key

# Collection name for storing vectors
VECTOR_DB_COLLECTION=context_keeper

# Vector dimension (must match embedding model, e.g., 1536 for text-embedding-v1)
VECTOR_DB_DIMENSION=1536

# Distance metric: cosine, euclidean, dot_product
VECTOR_DB_METRIC=cosine

# Similarity threshold for retrieval (0.0-1.0, higher = more strict)
SIMILARITY_THRESHOLD=0.4

# --- JD Cloud Vearch Configuration (Optional Alternative) ---
# VEARCH_URL=http://your-vearch-instance.jd.local
# VEARCH_USERNAME=root
# VEARCH_PASSWORD=your-password
# VEARCH_DATABASE=db
# VEARCH_REQUIRED_SPACES=context_keeper_vector,context_keeper_users


# =================================
# Embedding Service Configuration (Required)
# =================================

# Embedding API URL (Aliyun DashScope compatible endpoint)
EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings

# Embedding API key (Aliyun DashScope API key)
EMBEDDING_API_KEY=your-dashscope-api-key

# --- Batch Embedding Configuration (Optional) ---
# Batch embedding API URL for high-throughput processing
# BATCH_EMBEDDING_API_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding

# Batch queue size for parallel processing
# BATCH_QUEUE_SIZE=100

# Worker poll interval for batch processing
# BATCH_WORKER_POLL_INTERVAL=5s


# =================================
# LLM Configuration (Local-first with Cloud Fallback)
# =================================

# Primary LLM provider: ollama_local | deepseek | openai | claude
LLM_PROVIDER=ollama_local

# Model name for the selected provider
# Local: deepseek-coder-v2:16b, qwen2.5-coder:32b
# Cloud: deepseek-chat, gpt-4, claude-3-opus
LLM_MODEL=deepseek-coder-v2:16b

# Maximum tokens for LLM response
LLM_MAX_TOKENS=80000

# Temperature for LLM generation (0.0-1.0, lower = more deterministic)
LLM_TEMPERATURE=0.1

# LLM request timeout in seconds
LLM_TIMEOUT_SECONDS=600

# --- Cloud API Keys (Fallback Options) ---
# DeepSeek API key
DEEPSEEK_API_KEY=your-deepseek-key

# OpenAI API key
OPENAI_API_KEY=your-openai-key

# Claude API key
CLAUDE_API_KEY=your-claude-key


# =================================
# Timeline Storage (TimescaleDB/PostgreSQL)
# =================================

# Enable timeline storage for temporal context tracking
TIMELINE_STORAGE_ENABLED=true

# TimescaleDB host
TIMESCALEDB_HOST=localhost

# TimescaleDB port
TIMESCALEDB_PORT=5432

# Database name
TIMESCALEDB_DATABASE=context_keeper_timeline

# Database username
TIMESCALEDB_USERNAME=your-username

# Database password
TIMESCALEDB_PASSWORD=your-password


# =================================
# Knowledge Graph Storage (Neo4j)
# =================================

# Enable knowledge graph for entity relationship tracking
KNOWLEDGE_GRAPH_ENABLED=true

# Neo4j connection URI
NEO4J_URI=bolt://localhost:7687

# Neo4j username
NEO4J_USERNAME=neo4j

# Neo4j password
NEO4J_PASSWORD=your-neo4j-password

# Neo4j database name
NEO4J_DATABASE=neo4j


# =================================
# Session Management
# =================================

# Session timeout duration (e.g., 120m, 2h, 1d)
SESSION_TIMEOUT=120m

# Cleanup interval for expired sessions (e.g., 30m, 1h)
CLEANUP_INTERVAL=30m

# Short-term memory retention days
SHORT_MEMORY_MAX_AGE=3


# =================================
# JWT Authentication Configuration
# =================================

# JWT secret key (generate your own random string)
JWT_SECRET=replace-with-a-random-32-plus-char-secret

# Token expiry in hours (default: 24 hours)
# JWT_EXPIRY=24


# =================================
# CORS Configuration
# =================================

# Allowed origins (comma-separated list)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# Production example:
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com


# =================================
# Rate Limiting Configuration
# =================================

# Maximum requests per minute
RATE_LIMIT_PER_MIN=60

# Burst capacity (token bucket size)
RATE_LIMIT_BURST=100
